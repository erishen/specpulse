{
  "name": "specpulse-desktop",
  "version": "0.1.0",
  "description": "SpecPulse console (Electron + React): prompt on the left, live preview on the right",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "VITE_DEV_SERVER_URL=http://localhost:5277 electron .",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "37.10.3",
    "typescript": "^5.9.0",
    "vite": "^6.0.0"
  }
}
