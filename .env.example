# LLM provider (OpenAI-compatible). Same convention as datapulse: set either
# OPENAI_* or LLM_*; specpulse reads OPENAI_* first, then falls back to LLM_*.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Vision model for reference image generation (screenshots/mockups).
# Must support image input (e.g., gpt-4o, gpt-4-vision-preview, claude-3-*).
# Falls back to OPENAI_MODEL if not set.
OPENAI_VISION_MODEL=gpt-4o

# Optional: use a different API key / base URL for the vision model
# (e.g., when text and vision models come from different providers).
# Falls back to OPENAI_API_KEY / OPENAI_BASE_URL if not set.
# OPENAI_VISION_API_KEY=sk-...
# OPENAI_VISION_BASE_URL=https://api.openai.com/v1